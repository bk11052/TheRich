# TheRich 환경변수 (.env 로 복사해서 사용 — 기본값이 SQLite라 없어도 동작)
DATABASE_URL=sqlite:///./therich.db
APP_NAME=TheRich

# 텔레그램 봇 (선택 — 데이트비용 입력 창구)
# 1) 텔레그램에서 @BotFather 대화 → /newbot → 토큰 발급받아 아래에 붙여넣기
# 2) 봇 실행: python -m app.telegram_bot
# 3) 참여자가 각자 봇에게 /chatid → 나온 숫자를 POST /members 로 등록
#    (등록된 chat_id 만 입력을 받는다. 수신자 목록도 .env 가 아니라 DB 에서 읽는다.)
# 봇은 사람이 아니므로 세션 대신 서비스 토큰으로 API 를 쓴다.
# 긴 난수를 넣고 봇 쪽에서도 같은 값을 쓴다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SERVICE_TOKEN=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_ACCOUNT_ID=   # 미설정 시 카드/첫 계좌 자동 선택
# API_BASE_URL=http://127.0.0.1:8000

# 카카오 로컬 API (지도·지오코딩, 선택)
# https://developers.kakao.com → 애플리케이션 추가 → 앱 키
#  - REST API 키: 백엔드 지오코딩(상호명→좌표)용 → 아래에 입력
#  - JavaScript 키: 프론트 지도용 → web/.env.local 의 NEXT_PUBLIC_KAKAO_JS_KEY 에 입력
#    (+ 카카오 앱 > 플랫폼 > Web 에 http://localhost:3000 등록)
# KAKAO_REST_API_KEY=

# (Phase 2) 토스증권 오픈 API — 나중에 사용
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
