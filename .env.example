# TheRich 환경변수 (.env 로 복사해서 사용 — 기본값이 SQLite라 없어도 동작)
DATABASE_URL=sqlite:///./therich.db
APP_NAME=TheRich

# 텔레그램 봇 (선택 — 모바일 지출 입력 창구)
# 1) 텔레그램에서 @BotFather 대화 → /newbot → 토큰 발급받아 아래에 붙여넣기
# 2) 봇 실행(python -m app.telegram_bot) 후 봇에게 /chatid 를 보내 chat id 확인 → 아래에 입력
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_DEFAULT_ACCOUNT_ID=   # 미설정 시 카드/첫 계좌 자동 선택
# API_BASE_URL=http://127.0.0.1:8000

# (Phase 2) 토스증권 오픈 API — 나중에 사용
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
